EXPO_PUBLIC_SUPABASE_URL=
# Clave anon / publishable (nunca la service_role). También se acepta EXPO_PUBLIC_SUPABASE_KEY.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# RevenueCat (Project settings → API keys). Sin clave, los builds de desarrollo usan una compra simulada.
# En desarrollo puedes usar la clave de Test Store; nunca la subas a un build de App Store.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Identificador del entitlement que desbloquea Pro (por defecto "pro").
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=brote_pro
