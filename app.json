{
  "expo": {
    "name": "Brote",
    "slug": "brote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-light.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.carloshmitma.brote",
      "appleTeamId": "52MA26958Q",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.dev.carloshmitma.brote"
        ]
      },
      "icon": {
        "light": "./assets/icons/ios-light.png",
        "dark": "./assets/icons/ios-dark.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "infoPlist": {
        "CFBundleLocalizations": [
          "es",
          "en"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07061A",
        "foregroundImage": "./assets/icons/android-foreground.png",
        "backgroundImage": "./assets/icons/android-background.png",
        "monochromeImage": "./assets/icons/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/icons/android-legacy.png"
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07061A",
          "image": "./assets/icons/splash.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification.png",
          "color": "#C9B6FF"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "@bacons/apple-targets",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ]
    ],
    "scheme": "brote",
    "backgroundColor": "#07061A",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "dev.carloshmitma.brote.widget",
                  "targetName": "OrbeWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.dev.carloshmitma.brote"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "e8031c10-4acd-4d1d-a2af-b1762825dced"
      }
    },
    "owner": "sonnemon"
  }
}
